<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.bwstudio.bw-trader-scheduler</string>

    <key>WorkingDirectory</key>
    <string>/Users/brian/dev/AI-Trader/service</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/brian/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>TZ</key>
        <string>Asia/Taipei</string>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/brian/.local/bin/uv</string>
        <string>run</string>
        <string>--no-project</string>
        <string>python</string>
        <string>-m</string>
        <string>server.scheduler</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/Users/brian/Library/Logs/bw-trader-scheduler.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/brian/Library/Logs/bw-trader-scheduler.err.log</string>
</dict>
</plist>
