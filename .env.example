# ==================== Environment ====================
ENVIRONMENT=development

# ==================== Database ====================
# PostgreSQL takes precedence when DATABASE_URL is set.
DATABASE_URL=postgresql://
ai_trader:xxxxxx@127.0.0.1:5432/ai_trader

# SQLite fallback path when DATABASE_URL is empty.
DB_PATH=service/server/data/bw_trader.db

# ==================== API Keys ====================
ALPHA_VANTAGE_API_KEY=demo

# BW gpt-proxy (OpenAI-compatible upstream). Leave key blank to fall back to
# rule-based summary generation; do not commit a real key — pull via 1Password.
GPT_PROXY_URL=https://gpt-proxy.bw-space.com/v1
GPT_PROXY_KEY=
GPT_PROXY_MODEL=

# TW market data. TWSE OpenAPI is unauthenticated; FINMIND_TOKEN is optional
# (free tier works without it, paid tier raises the rate-limit ceiling).
TWSE_API_BASE=https://openapi.twse.com.tw/v1
FINMIND_API=https://api.finmindtrade.com/api/v4/data
FINMIND_TOKEN=
FINMIND_API_TOKEN=

# twmarketdata.com — invite-only paid TW data source. Optional fallback:
# twstock + TWSE OpenAPI + FinMind cover the same surface for free.
TWMARKETDATA_API_KEY=
TWMARKETDATA_BASE_URL=https://api.twmarketdata.com

# Broker API keys. Read-only first; ship live trade only after
# IP-whitelist + 2FA on the source account.
PIONEX_API_KEY=
PIONEX_API_SECRET=
CTBC_API_KEY=
CTBC_API_SECRET=

# Pionex AI Kit MCP. The server reads these env vars at MCP-subprocess
# spawn time; never paste real keys here. Use a read-only Pionex API key
# whenever possible — BW-Trader's no-auto-trade red line refuses to
# forward orders by default anyway, but defense-in-depth.
PIONEX_API_KEY=
PIONEX_API_SECRET=
PIONEX_BASE_URL=

# Spawn command for @pionex/pionex-trade-mcp. Override after installing
# globally (npm i -g @pionex/pionex-trade-mcp) to skip per-spawn `npx`
# lookup. Default below works as long as node >= 18 is on PATH.
PIONEX_AI_KIT_COMMAND=npx -y @pionex/pionex-trade-mcp

# Force the MCP subprocess into read-only mode (refuses every write tool
# at the source). MUST stay true in production; only set false in a
# deliberate live-trading rollout, and only after ALLOW_LIVE_TRADING is
# also flipped.
PIONEX_AI_KIT_READ_ONLY=true

# BW-Trader localization defaults. Override to switch a single install to US
# semantics without re-deploying.
BW_TRADER_DEFAULT_CURRENCY=TWD
BW_TRADER_DEFAULT_MARKET=tw-stock


# ==================== Frontend ====================
# Frontend auto-refresh interval in milliseconds.
VITE_REFRESH_INTERVAL=300000

# ==================== Network / CORS ====================
BW_TRADER_CORS_ORIGINS=http://localhost:3000,https://bw-trader.bw-space.com

# ==================== Market Data Endpoints
====================
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com

# ==================== Background Tasks ====================
POSITION_REFRESH_INTERVAL=300
MAX_PARALLEL_PRICE_FETCH=5
POLYMARKET_SETTLE_INTERVAL=60
MARKET_NEWS_REFRESH_INTERVAL=900
MACRO_SIGNAL_REFRESH_INTERVAL=900
ETF_FLOW_REFRESH_INTERVAL=900
STOCK_ANALYSIS_REFRESH_INTERVAL=1800

# ==================== Profit History Retention
====================
# Keep recent history at full resolution.
PROFIT_HISTORY_FULL_RESOLUTION_HOURS=24

# Keep compacted history inside this rolling window.
PROFIT_HISTORY_COMPACT_WINDOW_DAYS=7

# Bucket size used when compacting older profit history.
PROFIT_HISTORY_COMPACT_BUCKET_MINUTES=15

# Minimum interval between prune/compact passes.
PROFIT_HISTORY_PRUNE_INTERVAL_SECONDS=3600

# ==================== Price Fetch Reliability ====================
PRICE_FETCH_TIMEOUT_SECONDS=10
PRICE_FETCH_MAX_RETRIES=2
PRICE_FETCH_BACKOFF_BASE_SECONDS=0.35
PRICE_FETCH_ERROR_COOLDOWN_SECONDS=20
PRICE_FETCH_RATE_LIMIT_COOLDOWN_SECONDS=60