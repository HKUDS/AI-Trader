# ==================== Environment ====================
ENVIRONMENT=development

# ==================== Database ====================
# Choose ONE backend:
#
# 1) PostgreSQL (recommended for shared/production deployments)
#    Set DATABASE_URL and leave DB_PATH unused.
#    Example:
#    DATABASE_URL=postgresql://ai_trader:change-me@127.0.0.1:5432/ai_trader
#
# 2) SQLite (local-only quick start)
#    Leave DATABASE_URL empty. The API uses DB_PATH below.
#
# Precedence: if DATABASE_URL is non-empty, PostgreSQL is used and DB_PATH is ignored.
# Unit tests may set ALLOW_SQLITE=true when exercising SQLite helpers.
DATABASE_URL=

# SQLite file path — only used when DATABASE_URL is empty.
DB_PATH=service/server/data/clawtrader.db

# ==================== Cache / Redis ====================
# Optional locally. Required for a multi-process deployment: the standalone
# worker takes a Redis lock so only one instance refreshes prices and settles
# positions. On Render this is wired to the Key Value instance automatically.
REDIS_ENABLED=false
REDIS_URL=
REDIS_PREFIX=ai_trader

# ==================== API Keys ====================
# `demo` is Alpha Vantage's own public sample key: it works, but only for a
# handful of hardcoded symbols. Get a real one at
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=demo
# Optional: enrich US stock market-intel snapshots with Adanos social/news/prediction-market sentiment.
ADANOS_API_KEY=

# Optional: writes the stock-analysis summary paragraph. Without a key the app
# falls back to a deterministic template. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# ==================== Secrets ====================
# Pepper for the HMAC applied to session tokens before they are stored, so a
# database dump alone yields no live credentials. Required when
# ENVIRONMENT=production; rotating it logs everyone out.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
AI_TRADER_TOKEN_SECRET=

# Pepper for the pseudonymisation applied to research exports.
RESEARCH_EXPORT_HASH_SALT=

# ==================== Frontend ====================
# Frontend auto-refresh interval in milliseconds.
VITE_REFRESH_INTERVAL=300000

# Public URL of the API, baked into the bundle at build time. Leave empty when
# the SPA and the API share an origin (the Vite dev server proxies /api to
# VITE_DEV_API_PROXY). Set it when they are deployed separately.
VITE_API_BASE=

# Where `npm run dev` proxies /api to.
VITE_DEV_API_PROXY=http://localhost:8000

# ==================== Network / CORS ====================
# Exact origins only, comma-separated — never a wildcard or a *.onrender.com
# pattern, which would trust every other tenant on the platform.
CLAWTRADER_CORS_ORIGINS=http://localhost:3000

# ==================== Demo mode ====================
# Reserved for the public-demo gating layered on top of this deployment.
DEMO=false

# ==================== Market Data Endpoints ====================
ADANOS_API_BASE_URL=https://api.adanos.org
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com

# ==================== Background Tasks ====================
POSITION_REFRESH_INTERVAL=300
MAX_PARALLEL_PRICE_FETCH=5
POLYMARKET_SETTLE_INTERVAL=60
MARKET_NEWS_REFRESH_INTERVAL=900
MACRO_SIGNAL_REFRESH_INTERVAL=900
ETF_FLOW_REFRESH_INTERVAL=900
STOCK_ANALYSIS_REFRESH_INTERVAL=1800
ADANOS_SENTIMENT_CACHE_TTL_SECONDS=300
ADANOS_SENTIMENT_TIMEOUT_SECONDS=4

# ==================== Profit History Retention ====================
# Keep recent history at full resolution.
PROFIT_HISTORY_FULL_RESOLUTION_HOURS=24

# Keep compacted history inside this rolling window.
PROFIT_HISTORY_COMPACT_WINDOW_DAYS=7

# Bucket size used when compacting older profit history.
PROFIT_HISTORY_COMPACT_BUCKET_MINUTES=15

# Minimum interval between prune/compact passes.
PROFIT_HISTORY_PRUNE_INTERVAL_SECONDS=3600

# ==================== Price Fetch Reliability ====================
PRICE_FETCH_TIMEOUT_SECONDS=10
PRICE_FETCH_MAX_RETRIES=2
PRICE_FETCH_BACKOFF_BASE_SECONDS=0.35
PRICE_FETCH_ERROR_COOLDOWN_SECONDS=20
PRICE_FETCH_RATE_LIMIT_COOLDOWN_SECONDS=60
