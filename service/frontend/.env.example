# BW-Trader frontend env
# Copy to .env.local for local dev, set values in Vercel dashboard for prod.

# Backend FastAPI base URL (Render).
VITE_API_URL=https://bw-trader-api.onrender.com

# Public-facing domain (used for SKILL.md absolute URLs, share links, etc.)
VITE_PUBLIC_DOMAIN=https://bw-trader.bw-space.com

# Optional WebSocket URL override (defaults to derived from VITE_API_URL).
# VITE_WS_URL=wss://bw-trader-api.onrender.com
